## Reducción de dimensiones con MDS
#Normalizamos los datos
datosNormalizados<-scale(EmojisFood[,3:35])
rownames(datosNormalizados)<-EmojisFood$name
#Cálculo de distancias
distancias<-dist(datosNormalizados)
#Apliamos MDS
dimReducidas<-cmdscale(d=distancias, k=2)
#Convertimos a data.frame
dimReducidas<-as.data.frame(dimReducidas)
#Graficamos
mdsGrafica<-ggplot(dimReducidas, aes(V1, V2))
mdsGrafica<-mdsGrafica+geom_point()
mdsGrafica<-mdsGrafica+geom_label(aes(label=rownames(dimReducidas)), angle=45, size=3, hjust=1.1, check_overlap=TRUE)
mdsGrafica<-mdsGrafica+labs(tittle="Reducción de dimensiones con MDS", subtitle = "Ejemplo de MDS", x="Dimensión 1", y="Dimensión 2")
mdsGrafica<-mdsGrafica+geom_density2d()
mdsGrafica
#Aplicamos tsne
tsneReducidas <- tsne(distancias, k=2, perplexity = 5, max_iter = 1000)
#Convertimos a dataframe
tsneReducidas <- as.data.frame(tsneReducidas)
#Graficamos
tsneGrafica<-ggplot(dimReducidas, aes(V1, V2))
tsneGrafica<-tsneGrafica+geom_point()
tsneGrafica<-tsneGrafica+geom_label(aes(label=rownames(dimReducidas)), angle=45, size=3, hjust=1.1, check_overlap=TRUE)
tsneGrafica<-tsneGrafica+labs(tittle="Reducción de dimensiones con MDS", subtitle = "Ejemplo de MDS", x="Dimensión 1", y="Dimensión 2")
tsneGrafica<-tsneGrafica+geom_density2d()
tsneGrafica
