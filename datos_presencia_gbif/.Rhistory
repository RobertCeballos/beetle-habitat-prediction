ddispersion= ddispersion+geom_point()+geom_label(aes(label=EmojisFood$name))
ddispersion
ddispersion= ddispersion+labs(title = "Relación de Carbohidratos y Calorias", subtitle="Ejemplo de diagrama de dispersión", x="Calorias", y="Carbohidratos")
ddispersion
